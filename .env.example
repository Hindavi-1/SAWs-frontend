# Frontend environment. Copy to `.env.local` and adjust for your environment.

# Base URL the browser uses to reach the FastAPI backend. When unset the UI calls
# the same origin and relies on the server-side /api proxy below, which is what
# you want behind a single deployed domain.
NEXT_PUBLIC_API_URL=

# Backend origin for the server-side `/api/*` proxy in next.config.ts. Set this in
# deployment (e.g. https://api.example.com); it defaults to the local dev backend.
BACKEND_URL=

# When "true", a failed backend call silently renders bundled mock data so the UI
# looks populated without a backend. Leave unset (or "false") everywhere except
# local demos — otherwise a backend outage is hidden behind fabricated data.
NEXT_PUBLIC_ENABLE_MOCK_FALLBACKS=

# Google Maps JavaScript API browser key. Use a SEPARATE key from the backend's
# Places key and restrict it to your web referrers (Google Cloud Console → Credentials).
# It is only used to render maps in the browser; when unset the map views show a
# fallback instead of a map. Places autocomplete goes through the backend proxy, so
# the server-side key is never exposed here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional region bias for the browser map (e.g. "IN"). Keeps map results aligned
# with the ICP's geography. Leave blank for no bias.
NEXT_PUBLIC_GOOGLE_MAPS_REGION=
